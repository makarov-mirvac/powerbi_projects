table '# Finance Calcs'
	lineageTag: 582e8ea5-4fab-48b5-ab72-eb9cfa68fde0

	measure '% Amount' = SUM('Transactions'[Amount])
		lineageTag: e38fe646-7227-4a96-ae66-81525d9d5518

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Adjusted SubContract Sum' = [Total Contract Value] + [Total Variations]
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: eff16a71-2457-45ae-b2b4-c4f625618756

	measure Amount =
			
			var AMOUNT = SUM('Transactions'[Amount])
			var Reference = RIGHT(LEFT(SELECTEDVALUE(Budget[Reference]),4),1)
			RETURN IF ((SELECTEDVALUE('Metric'[Metric BK])) = "CostCard-UncommittedOrders"  && Reference = "M" && AMOUNT  < 0 , 0, AMOUNT)
			
			//SUM('Transactions'[Amount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: e43e0225-63ee-48e8-a6d1-0d0ca1298757

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Amount_Int = SUM('Transactions'[Amount])
		formatString: 0
		lineageTag: f5f987a7-7678-462d-a11d-78d73d34b601

