	measure 'Bank Guarantee Amount' = CALCULATE(SUM('Transactions'[Amount]), Metric[Metric BK] = "Contract-BankGuaranteeAmount")
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 05fd488b-f740-4e5f-867e-1d750913e22b

	measure 'Certified To Date' =
			
			VAR MaxDateTime =
			    COALESCE (
			        DATEVALUE ( SELECTEDVALUE ( 'Calendar'[Date] ) ),
			        TODAY ()
			    )
			VAR MetricSK =
			    CALCULATE (
			        MAX ( 'Metric'[Metric SK] ),
			        'Metric'[Metric BK] = "ClaimReport-ValueCompleted"
			    )
			RETURN
			SUMX (
			    VALUES ( Contract[Contract Reference] ),
			    VAR TranDateTime =
			        CALCULATE (
			            MAX ( 'Budget Linked Item'[Create Date] ),
			            'Budget Linked Item'[Create Date] <= MaxDateTime,
			            'Transactions'[Metric SK] = MetricSK
			        )
			    VAR MaxReference =
			        CALCULATE (
			            MAX ( 'Budget Linked Item'[Reference] ),
			            FILTER (
			                ALL ( 'Budget Linked Item' ),
			                'Budget Linked Item'[Create Date] = TranDateTime
			            )
			        )
			    RETURN
			        CALCULATE (
			            SUM ( 'Transactions'[Amount] ),
			            USERELATIONSHIP (
			                'Calendar'[Date SK],
			                'Transactions'[Date SK]
			            ),
			            Metric[Metric BK] = "ClaimReport-ValueCompleted",
			            FILTER (
			                'Budget Linked Item',
			                'Budget Linked Item'[Create Date] = TranDateTime
			                    && 'Budget Linked Item'[Reference] = MaxReference
			            )
			        )
			)
		lineageTag: e79d6e71-d8e0-4679-8b6b-b6b3f658d20e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Certified To Date %' = ```
