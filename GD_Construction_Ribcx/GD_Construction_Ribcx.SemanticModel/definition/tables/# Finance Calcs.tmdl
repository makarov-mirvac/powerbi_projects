	measure 'Retention Amount' = ```
			--CALCULATE(SUM(Transactions[Amount]), Metric[Metric BK] = "Claim-RetentionAmount")
			//var maxDate = COALESCE(SELECTEDVALUE('Calendar'[Date]), TODAY())
			//var transDate = CALCULATE(MAX('Transactions'[Date SK]), 'Calendar'[Date] <= maxDate, Metric[Metric BK] = "Claim-RetentionAmount", 'Transaction Status'[Status] = "APPROVED") 
			//var transAmount = CALCULATE(SUM('Transactions'[Amount]), 'Transactions'[Date SK] = transDate, Metric[Metric BK] = "Claim-RetentionAmount") 
			
			var maxDateTime = COALESCE(DATEVALUE(SELECTEDVALUE('Calendar'[Date])), NOW()) // DATEVALUE("15/04/2023 12:00:00")
			var metricSK = CALCULATE(MAX('Metric'[Metric SK]), 'Metric'[Metric BK] = "Claim-RetentionAmount")
			var tranDateTime = CALCULATE(MAX('Budget Linked Item'[Create Date]), 'Budget Linked Item'[Create Date] <= maxDateTime, 'Transactions'[Metric SK] = metricSK, 'Transaction Status'[Status] = "APPROVED")
			RETURN CALCULATE(SUM('Transactions'[Amount])
			                            , Metric[Metric BK] = "Claim-RetentionAmount"
			                            , FILTER('Budget Linked Item','Budget Linked Item'[Create Date] = tranDateTime )) 
			
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 46be5647-3c17-4435-aeb7-0a32f70ab4b6

