	measure 'Variance Working Forecast' = ```
			
			    IF (HASONEVALUE('Budget Linked Item'[Reference]), 
			        [Variance Working Forecast - One Variation]
			    ,
			        SUMX('Budget Linked Item', [Variance Working Forecast - One Variation])
			    )
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 76b56a46-f175-480b-b166-e332f45feb57

	measure 'Variance Working Forecast - One Variation' =
			
			var wf = CALCULATE(SUM('Transactions'[Amount]), Metric[Metric BK] = "ContractVariation-WorkingForecast", 'Transaction Status'[Status Type] = "Open")
			var cv = CALCULATE(SUM('Transactions'[Amount]), Metric[Metric BK] = "ContractVariationAmount", 'Transaction Status'[Status Type] = "Open")
			var ret = IF (wf = BLANK(), cv, wf)
			RETURN ret
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		isHidden
		lineageTag: 3af587eb-9251-43e9-b9b6-2eabd0ab18c8

	measure Amount_const = ```
			
			VAR SelectedMonth = SELECTEDVALUE('Calendar'[Month Name])	// e.g., "November 2025"
			VAR FirstOfMonthInt = YEAR(SelectedMonth) * 10000 + MONTH(SelectedMonth) * 100 + 1
			VAR AMOUNT = 
			    CALCULATE(
			        SUM('Transactions'[Amount]),
			           ALLEXCEPT( 'Calendar', 'Calendar'[Date SK] ),
			         Transactions[Report Month]
			            <= FirstOfMonthInt
			    )
			VAR Reference = RIGHT(LEFT(SELECTEDVALUE(Budget[Reference]),4),1)
			RETURN 
			   IF (
			        SELECTEDVALUE('Metric'[Metric BK]) = "CostCard-UncommittedOrders" &&
			        Reference = "M" &&
			        AMOUNT < 0,
			        0,
			        AMOUNT
			    )
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: d95c6a12-87e8-49fd-915b-1099a9f68d2e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Certified To Date - This claim' =
			
			VAR IsFYFiltered =
			    ISFILTERED ( 'Budget Linked Item'[Claim Issued Date] )
			
			VAR MaxDateTime =
			    COALESCE (
			        DATEVALUE ( SELECTEDVALUE ( 'Calendar'[Date] ) ),
			        TODAY ()
			    )
			
			VAR MetricSK =
			    CALCULATE (
			        MAX ( 'Metric'[Metric SK] ),
			        'Metric'[Metric BK] = "ClaimReport-ValueCompleted"
			    )
			
			VAR CertifiedToDate =
			    SUMX (
			        VALUES ( Contract[Contract Reference] ),
			        VAR TranDateTime =
			            CALCULATE (
			                MAX ( 'Budget Linked Item'[Create Date] ),
			                'Budget Linked Item'[Create Date] <= MaxDateTime,
			                'Transactions'[Metric SK] = MetricSK
			            )
			        VAR MaxReference =
			            CALCULATE (
			                MAX ( 'Budget Linked Item'[Reference] ),
			                FILTER (
			                    ALL ( 'Budget Linked Item' ),
			                    'Budget Linked Item'[Create Date] = TranDateTime
			                )
			            )
			        RETURN
			            CALCULATE (
			                SUM ( 'Transactions'[Amount] ),
			                USERELATIONSHIP (
			                    'Calendar'[Date SK],
			                    'Transactions'[Date SK]
			                ),
			                'Metric'[Metric BK] = "ClaimReport-ValueCompleted",
			                FILTER (
			                    'Budget Linked Item',
			                    'Budget Linked Item'[Create Date] = TranDateTime
			                        && 'Budget Linked Item'[Reference] = MaxReference
			                )
			            )
			    )
			
			VAR FYScheduleAmount =
			    CALCULATE (
			        SUM ( 'Transactions'[Amount] ),
			        'Metric'[Metric BK] = "ClaimReport-Schedule"
			    )
			
			RETURN
			    IF (
			        IsFYFiltered,
			        FYScheduleAmount,
			        CertifiedToDate
			    )
		lineageTag: f9d7472e-702c-4fd0-8b44-a3ccedbcb8cb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

