	column 'Claim Issued Date' =
			
			IF (
			'Budget Linked Item'[Linked Item Type] = "Claim",
			"FY"
			& RIGHT (
			YEAR ( 'Budget Linked Item'[Issued Date] )
			+ IF ( MONTH ( 'Budget Linked Item'[Issued Date] ) >= 7, 1, 0 ),
			2
			),
			BLANK ()
			)
		lineageTag: 271d4226-a280-46e8-8c84-5dbabec6e805
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Budget Linked Item' = m
		mode: import
		source =
