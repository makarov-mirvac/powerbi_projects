				    DIM_BUDGET_LINKED_ITEM_View = BAL_Schema{[Name="DIM_BUDGET_LINKED_ITEM_VW",Kind="View"]}[Data]
				in
				    DIM_BUDGET_LINKED_ITEM_View

	annotation PBI_ResultType = Table

