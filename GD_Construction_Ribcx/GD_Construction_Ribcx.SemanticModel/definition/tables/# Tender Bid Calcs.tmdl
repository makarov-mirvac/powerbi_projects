	measure 'Package Manager' = ```
			
			    var TenderPackageUser = SELECTEDVALUE('Tenderer Lists'[User SK])
			RETURN CALCULATE(MAX('User'[User Name]), FILTER('User', 'User'[User SK] = TenderPackageUser))
			```
