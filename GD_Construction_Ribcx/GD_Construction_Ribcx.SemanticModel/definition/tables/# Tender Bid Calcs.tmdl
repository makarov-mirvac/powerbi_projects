	measure 'Total Approved Budget' = CALCULATE(SUM('Tender Bids'[Amount]),FILTER('Tender Bid Type','Tender Bid Type'[Tender Bid Display] = "Approved Budget"), Bidder[Company Name] = "Approved Budget")
		lineageTag: 139076b0-540d-451e-a26e-5720c387ea92

