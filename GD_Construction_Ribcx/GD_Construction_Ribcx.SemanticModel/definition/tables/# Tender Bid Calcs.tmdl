table '# Tender Bid Calcs'
	lineageTag: 689b5f94-7574-4cbe-ad89-08709b63f442

	measure 'Actual Lead Time' = ```
			
			           DATEDIFF(
			                SELECTEDVALUE('Tender Documents'[PEA Approval Date]),
			                SELECTEDVALUE('Tender Documents'[PEA Start On Site Date]), 
			                DAY
			     )
			```
		formatString: 0
		lineageTag: 18902459-421f-4b93-99c2-290701d27d71

	measure 'Actual PEA Lead Time' = ```
			
			    DATEDIFF(
			        SELECTEDVALUE('Tender Documents'[PEA Issued Date])
			        , SELECTEDVALUE('Tender Documents'[PEA Approval Date])
			        ,  DAY
			    )
			```
		formatString: 0
		lineageTag: 97f2c4ff-7dd8-461f-aa6c-e56ec0d67079

	measure 'Actual Tender Preparation Time' = ```
			
			    DATEDIFF(
			        SELECTEDVALUE('Tender Documents'[TenderList Issued Date]),
			        SELECTEDVALUE('Tender Package'[Tender Issued Date]),
			        DAY
			    )
			```
		formatString: 0
		lineageTag: 58fbe49d-db36-4f28-90f2-022056da2b64

	measure 'Actual Vetting Period' = ```
			
			    DATEDIFF(
			        SELECTEDVALUE('Tender Package'[Tender Due Date]), 
			        SELECTEDVALUE('Tender Documents'[PEA Issued Date]), 
			        DAY
			    )
			```
		formatString: 0
		lineageTag: 9d5149da-73ce-4965-ade9-1c2c5f43fbe0

	measure 'Additional Items' = CALCULATE(sum('Tender Bids'[Amount]),FILTER('Tender Bid Type','Tender Bid Type'[Tender Bid Display] = "Additional Items"))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 1e2eacf9-70a1-45c7-95de-4a23ad60a389

	measure 'Approved Budget' = CALCULATE(SUM('Tender Bids'[Amount]),FILTER('Tender Bid Type','Tender Bid Type'[Tender Bid Display] = "Approved Budget"))
		lineageTag: 3f9927cd-ae8c-4985-a142-8adf289de91a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CF_Bidder =
			
			VAR SelectedBidderSub = SELECTEDVALUE(Bidder[Company Name])
			VAR RankTable = ALLSELECTED(Bidder[Company Name])
			VAR BidRank =
			RANKX (
			    RankTable,
			    Bidder[Company Name],
			    SelectedBidderSub,
			    ASC,
			    Dense
			)
			VAR CF = IF(ISEVEN(BidRank),"yes","no")
			RETURN CF
		lineageTag: 97b9bb69-ecf4-4f00-8da4-40c4acef0f0b

	measure EV% = DIVIDE([Potential Variation], [Subtotal T_Submissions],0)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 9a0df339-e1fb-4a08-8231-288ac31041d1

	measure 'Forecast Final Cost' = CALCULATE(SUM('Tender Bids'[Amount]), FILTER('Tender Bid Type','Tender Bid Type'[Tender Bid Display] = "Forecast Final Cost") )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 9099c443-9057-48b5-8c41-c51ac4134c06

	measure 'Is Likely Let' = MAX('Tender Bids'[Likely Let Flag])
		formatString: 0
		lineageTag: f7f4b249-f02d-4498-bc1b-a5287c01a2a6

	measure 'Max Bid' = ```
			
			var Vals = 
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            FILTER (
			                SUMMARIZE('Tender Bids', 'Tender Package'[Reference], 'Bidder'[Company Name],'Tender Bid Type'[Tender Bid Description] ),
			                'Tender Bid Type'[Tender Bid Description] = "Tender Submission" ),
			            "BidAmt", [Value]
			        ),
			        ALLSELECTED()
			    )
			RETURN
			    MAXX (Vals, [BidAmt] )
			```
		lineageTag: 4dc8fbec-2459-465b-9ca9-46121c7e2e2e

	measure 'Min Bid' = ```
			
			var Vals = 
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            FILTER (
			                SUMMARIZE('Tender Bids', 'Tender Package'[Reference], 'Bidder'[Company Name],'Tender Bid Type'[Tender Bid Description] ),
			                'Tender Bid Type'[Tender Bid Description] = "Tender Submission" ),
			            "BidAmt", [Value]
			        ),
			        ALLSELECTED()
			    )
			RETURN
			    MINX (Vals, [BidAmt] )
			```
		lineageTag: fe9dc124-053b-4450-8aee-73a9af901451

	measure 'PEA Agreement Execution Date' = ```
			
			var ret =    
			        CALCULATE(
			            MAX('Contract'[Agreement Execution Date]), 
			            USERELATIONSHIP('Tender Documents'[PEA Contract SK], 'Contract'[Budget Linked Item SK])
			        )
			RETURN  if (ret = BLANK(), BLANK(), ret)
			```
		formatString: dd/mm/yy
		lineageTag: f16c7081-7e64-4bf4-9ed3-e30a8357b998

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure 'PEA Commitment Type' = ```
			
			var ret =    
			        CALCULATE(
			            MAX('Contract'[Commitment Type]), 
			            USERELATIONSHIP('Tender Documents'[PEA Contract SK], 'Contract'[Budget Linked Item SK])
			        )
			RETURN  if (ret = BLANK(), BLANK(), ret)
			```
		lineageTag: 210b17ea-0d3e-451c-86b4-d2c98867876a

	measure 'PEA Contract Value' = ```
			
			var ret =    
			        CALCULATE(
			            SUM ('Transactions'[Amount]), 
			            USERELATIONSHIP('Tender Documents'[PEA Contract SK], 'Contract'[Budget Linked Item SK]),
			            FILTER('Metric', 'Metric'[Metric BK] = "Contract-ContractTotal")
			        )
			RETURN if (ret = BLANK(), BLANK(), ret)
			```
		lineageTag: 88859a1a-d7cc-4be8-982e-1960db701d6c

	measure 'PEA Security Type' = ```
			
			var ret =    
			        CALCULATE(
			            MAX('Contract'[Security Type]), 
			            USERELATIONSHIP('Tender Documents'[PEA Contract SK], 'Contract'[Budget Linked Item SK])
			        )
			RETURN  if (ret = BLANK(), BLANK(), ret)
			```
		lineageTag: af68bb1d-98e9-4af4-8ec5-8dadfe9d9ce5

	measure 'Potential Variation' = CALCULATE(sum('Tender Bids'[Amount]),FILTER('Tender Bid Type','Tender Bid Type'[Tender Bid Display] = "Potential Variation"))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 6e410203-5494-4327-a2a6-9d4b15d24107

	measure Quantity = SUM('Tender Bids'[Quantity])
