	column 'Days Open' = DATEDIFF('Document'[Issued Date], TODAY(), DAY)
		formatString: 0
		lineageTag: 10f670da-9e4d-442c-a00d-733a751fb58b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Days to Close' = DATEDIFF('Document'[Issued Date], 'Document'[Last Closed Date], DAY)
		formatString: 0
		lineageTag: e0de0997-971f-48a9-a99a-5ad61c3cb4b0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Defect Band' = ```
			
			    IF ([Doc Code] = "DEF",
			        IF ([Status Type] = "Closed" ,
			            IF ([Days to Close] <= 10, 
			                1, 
			                IF ([Days to Close] <= 20, 
			                    2, 
			                    IF ([Days to Close] <= 30, 3, 4) 
			                ) 
			            ),
			            IF ([Days Open] <= 10, 
			                6, 
			                IF ([Days Open] <= 20, 
			                    7, 
			                    IF ([Days Open] <= 30, 8, 9) 
			                    ) 
			                )
			        ),
			        IF ([Doc Code] = "ITPCHK2",
			            IF ([Status Type] = "Open" ,
			                IF ([Overdue Days] <= 0,
			                    0,
			                    IF ([Overdue Days] <= 15, 
			                        10, 
			                        IF ([Overdue Days] <= 30, 
			                            11, 
			                            IF ([Overdue Days] <= 45, 12, 13) 
			                        ) 
			                    )
			                )
			            ),
			            0
			        )
			    )
			
			
			```
		lineageTag: f024b6f6-e0c4-479b-ba24-40ad7959216b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Defect Type' =
			
			var docType = SWITCH ('Document'[Doc Code] , "DEF", "Defects", "ITPCHK", "ITP", "SMP", "Samples", "FP", "Firewall Penetrations","" )
			RETURN SWITCH (
			     TRUE(),
			'Document'[Status Type] <> "Closed" && 'Document'[Overdue Days]<= 0,"Outstanding " & docType,
			 'Document'[Status Type] = "Open" && 'Document'[Overdue Days] > 0,"Overdue " & docType,
			'Document'[Status Type] = "Closed" ,"Closed " & docType
			)
		lineageTag: baf9265c-a14d-46b8-b9a3-29ff99f85167
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Closed' = IF([Status Type] = "Closed",  IF( ISBLANK( [Last Closed Date] ) , 0, 1), 0)
		formatString: 0
		lineageTag: cecd196b-4f33-433c-b39a-a2e2177805a0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Overdue Days' = DATEDIFF([Due Date], TODAY(), DAY)
		formatString: 0
		lineageTag: cb5e2d8c-b8a3-4189-8f07-11d9c891883c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'QA Type' =
			
			var StatusName =
			    IF ([Doc Code] = "SMP" || [Doc Code] = "FP",
			        SWITCH([Status Name]
			            , "ACCEPTED", "Accepted"
			            , "REJECTED", "Rejected"
			            , "CLOSED", "Closed"
			            , "IN PROGRESS", "In Progress"
			            , "OPEN", "Open"
			            , ""
			            )
			        )
			RETURN
			        IF(StatusName = "In Progress" || StatusName = "Open", IF(LEFT([Defect Type], 7) = "Overdue", "Overdue", StatusName), StatusName)
		lineageTag: e32858fd-6fc7-4ccc-863a-6ea3340f3af3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

