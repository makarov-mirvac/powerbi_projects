          "expression": "CALCULATE([Local_ForecastFinalBudget],FILTER(ALL('Calendar'[Date]),'Calendar'[Date] <= MAX('Calendar'[Date])))",
          "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
          "references": {
