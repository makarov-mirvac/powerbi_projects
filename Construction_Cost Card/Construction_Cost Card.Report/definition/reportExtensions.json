            "measures": [
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "Local Variance Max Date"
              },
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "Local Variance Last report"
              }
            ]
          }
        },
        {
          "name": "Local Variance Movement Max date",
          "dataType": "Double",
          "expression": "[Local Variance Max Date] - [Local Variance Last report]",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "Local Variance Max Date"
              },
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "Local Variance Last report"
              }
            ]
          }
        },
        {
          "name": "local forecast final cost",
          "dataType": "Double",
          "expression": "CALCULATE([Local_ForecastFinalCost],FILTER(ALL('Calendar'[Date]),'Calendar'[Date] <= MAX('Calendar'[Date])))",
          "formatString": "\\$#,0;(\\$#,0);\\$#,0",
