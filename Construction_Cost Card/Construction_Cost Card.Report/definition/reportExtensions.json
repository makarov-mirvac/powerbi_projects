          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "local forecast final budget"
              },
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "local forecast final cost"
              }
            ]
          }
        },
        {
          "name": "Local Variance Last report",
          "dataType": "Double",
          "expression": "CALCULATE([Local_ForecastFinalBudget]-[Local_ForecastFinalCost],FILTER(ALL('Calendar'[Date]), 'Calendar'[Date] <= MIN('Calendar'[Date])))\r\n",
          "formatString": "\\$#,0;(\\$#,0);\\$#,0",
          "references": {
            "measures": [
              {
                "schema": "extension",
