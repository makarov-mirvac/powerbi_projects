{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/reportExtension/1.0.0/schema.json",
  "name": "extension",
  "entities": [
    {
      "name": "Metric",
      "measures": [
        {
          "name": "Local_ForecastFinalBudget",
          "dataType": "Double",
          "expression": "CALCULATE([Amount], Metric[Display Name] = \"Final Forecast Budget\")",
          "formatString": "\\$#,0;(\\$#,0);\\$#,0",
          "references": {
            "measures": [
              {
                "entity": "# Finance Calcs",
                "name": "Amount"
              }
            ]
          }
        },
        {
          "name": "Local_ForecastFinalCost",
          "dataType": "Double",
          "expression": "CALCULATE([Amount], Metric[Display Name] = \"Forecast Final Cost\")",
          "formatString": "\\$#,0;(\\$#,0);\\$#,0",
          "references": {
            "measures": [
              {
                "entity": "# Finance Calcs",
                "name": "Amount"
              }
            ]
          }
        },
        {
          "name": "Local Variance",
          "dataType": "Double",
          "expression": "[Local_ForecastFinalBudget]-[Local_ForecastFinalCost]\r\n\r\n",
          "hidden": true,
          "formatString": "\\$#,0;(\\$#,0);\\$#,0",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "Local_ForecastFinalBudget"
              },
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "Local_ForecastFinalCost"
              }
            ]
          }
        },
        {
          "name": "Local Variance Last Month",
          "dataType": "Double",
