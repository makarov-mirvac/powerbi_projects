          "hidden": true,
          "formatString": "\\$#,0;(\\$#,0);\\$#,0",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "Local Variance"
              }
            ]
          }
        },
        {
          "name": "Local Variance Movement",
          "dataType": "Double",
          "expression": "[Local Variance Max Date]-[Local Variance Last report]",
          "formatString": "\\$#,0;(\\$#,0);\\$#,0",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "Local Variance Max Date"
              },
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "Local Variance Last report"
              }
            ]
          }
        },
        {
          "name": "Local FFC Max Date",
          "dataType": "Double",
          "expression": "IF(SELECTEDVALUE(Metric,[Max date]),[Local_ForecastFinalCost])",
          "hidden": true,
          "formatString": "\\$#,0;(\\$#,0);\\$#,0",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "Max date"
              },
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "Local_ForecastFinalCost"
              }
            ]
          }
        },
        {
          "name": "Max date",
          "dataType": "Double",
          "expression": "CALCULATE(MAX('Calendar'[Date]))"
        },
        {
          "name": "Min date",
          "dataType": "Double",
          "expression": "CALCULATE(min('Calendar'[Date]))"
        },
        {
          "name": "Local FFB Max Date",
          "dataType": "Double",
          "expression": "CALCULATE([Local_ForecastFinalBudget],FILTER(Metric,[Max date]))",
          "hidden": true,
          "formatString": "\\$#,0;(\\$#,0);\\$#,0",
