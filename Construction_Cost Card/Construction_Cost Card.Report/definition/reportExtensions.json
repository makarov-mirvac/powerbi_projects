            "measures": [
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "Local_ForecastFinalBudget"
              },
              {
                "schema": "extension",
                "entity": "Metric",
                "name": "Max date"
              }
            ]
          }
        },
        {
          "name": "Local Variance Max Date",
